# Copy the names you need into .env in the repository root. Keep your own values private.
NEBIUS_API_KEY=
TAVILY_API_KEY=
# Optional: change if the default model is not enabled for your Nebius account.
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
# Optional for local development only. The deployed site reads public/data/opportunities.json.
VITE_QADAM_API_URL=http://127.0.0.1:8787

# Only newly issued bot credentials. Do not use the credentials previously committed to GitHub.
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=QadamAgentBot
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
DISCORD_INVITE_URL=
WEB_APP_URL=https://nvidia-pathfinder.vercel.app
# Optional override: bots read the public GitHub radar JSON by default.
RADAR_DATA_URL=

# Kakao Login (REST API). Use the REST API key from Kakao Developers > App Keys, not the app ID.
# Register the redirect URI under Kakao Login > Redirect URI.
VITE_KAKAO_APP_ID=1613530
VITE_KAKAO_REST_API_KEY=
VITE_KAKAO_REDIRECT_URI=https://nvidia-pathfinder.vercel.app/welcome
# Optional: override the token exchange endpoint (defaults to the Vercel function /api/kakao/token).
VITE_KAKAO_TOKEN_ENDPOINT=
# Server-side only (Vercel env): never prefix with VITE_.
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=https://nvidia-pathfinder.vercel.app/welcome
KAKAO_CLIENT_SECRET=
