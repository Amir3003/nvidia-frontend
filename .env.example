# Copy the names you need into .env in the repository root. Keep your own values private.
NEBIUS_API_KEY=
TAVILY_API_KEY=
# Optional: change if the default model is not enabled for your Nebius account.
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
# Optional for local development only. The deployed site reads public/data/opportunities.json.
VITE_QADAM_API_URL=http://127.0.0.1:8787

# Only newly issued bot credentials. Do not use the credentials previously committed to GitHub.
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=QadamAgentBot
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
DISCORD_INVITE_URL=
WEB_APP_URL=https://nvidia-pathfinder.vercel.app
# Optional override: bots read the public GitHub radar JSON by default.
RADAR_DATA_URL=

# Shared network: public client credentials only (never service_role).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# KakaoTalk bot (Kakao i Open Builder chatbot in the QADAM channel).
# Public channel id from pf.kakao.com/_xxxx: the Notifications card opens its chat.
VITE_KAKAO_CHANNEL_ID=
# Server-side only (Vercel env). Upstash Redis REST credentials; the Vercel Upstash
# integration sets KV_REST_API_URL and KV_REST_API_TOKEN automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional header value Kakao i Open Builder sends as x-qadam-skill-key.
KAKAO_SKILL_SECRET=
# Proactive alerts (Event API): bot ID from Open Builder and the app's REST API key.
# Needs a business-verified channel and a wallet linked to the bot (paid per message).
KAKAO_BOT_ID=
KAKAO_REST_API_KEY=
# Vercel sends it to the daily /api/kakao/notify cron; also used for manual runs.
CRON_SECRET=
